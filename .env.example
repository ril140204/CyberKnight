# ===========================================
# CyberKnight / Sigmabloom — Environment Variables
# ===========================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env or .env.* to git (they are already in .gitignore).

# --- Server & Domain ---
DOMAIN=yourdomain.com
PORT=3000

# --- MySQL Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=cyberknight

# --- SePay API (Payment Gateway) ---
SEPAY_API_KEY=your_sepay_api_key_here
SEPAY_WEBHOOK_SECRET=your_webhook_secret_here
SEPAY_TRANSFER_NOTIFY_URL=https://yourdomain.com/api/sepay/webhook

# --- JWT & Security ---
JWT_SECRET=generate_a_random_256bit_string_here
JWT_EXPIRES_IN=7d

# --- Session / Cookie ---
SESSION_SECRET=generate_another_random_string_here

# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="CyberKnight <noreply@yourdomain.com>"

# --- Admin Panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_immediately

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5500

# --- PM2 / Deployment ---
# PM2_CLUSTER_MODE=cluster
# PM2_INSTANCES=2
