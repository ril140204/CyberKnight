{
  "name": "cyberknight",
  "version": "1.0.0",
  "private": true,
  "description": "CyberKnight Web Project",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "node backend/src/server.js",
    "test": "npm --prefix backend test",
    "test:all": "npm --prefix backend run test:all",
    "build:css": "tailwindcss -i ./assets/tailwind-input.css -o ./assets/tailwind.css --minify && python3 -I scripts/stamp-assets.py",
    "build:icons": "bash scripts/build-icons.sh",
    "setup-db": "npm --prefix backend run setup-db",
    "encode:videos": "bash scripts/encode-videos.sh",
    "heroku-postbuild": "npm --prefix backend ci --omit=dev"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
