# ==============================================================================
# CyberKnight / Sigmabloom — File Cấu Hình Mẫu (.env.example)
#
# HƯỚNG DẪN:
# 1. Sao chép file này thành .env trong thư mục backend/ (hoặc thư mục gốc)
#    cp backend/.env.example backend/.env
# 2. Điền đầy đủ thông tin bí mật của bạn. KHÔNG commit file .env thật lên git!
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sigmabloom

# ==============================================================================
# BẢO MẬT & JWT SECRETS (Bắt buộc tối thiểu 32 ký tự, không được trùng nhau)
# Tạo nhanh bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==============================================================================
JWT_SECRET=
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Level Access Cookie Secret (Ký JWT trong cookie HttpOnly levelAccess)
LEVEL_ACCESS_SECRET=

# ==============================================================================
# KHỞI TẠO TÀI KHOẢN ADMIN (SEED ADMIN)
# Production yêu cầu mật khẩu >= 12 ký tự, đủ chữ hoa, thường, số, ký tự đặc biệt
# ==============================================================================
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@sigmabloom.vn

# CORS & Frontend URL
FRONTEND_URL=http://localhost:5000
# Thêm các Origin phụ khác nếu cần (phân tách bằng dấu phẩy):
# CORS_ORIGINS=https://sigmabloom.vn,https://cyberknight.vn
# Production: thay bằng tên miền thật, ví dụ:
# CORS_ORIGINS=https://www.<TEN_MIEN>
# (Không thêm http://localhost:5000 vào CORS_ORIGINS ở production)

# ==============================================================================
# CẤU HÌNH CỔNG THANH TOÁN & NGÂN HÀNG (VIETQR / SEPAY)
# ==============================================================================
# Số tài khoản ngân hàng nhận tiền
BANK_ACCOUNT=
# Tên chủ tài khoản (in hoa không dấu)
BANK_NAME=
# Mã BIN ngân hàng (Tra cứu: VietinBank=970415, Vietcombank=970436, MBBank=970422, BIDV=970418)
BANK_BIN=

# SePay Webhook API Key (Header chuẩn: "Authorization: Apikey <SEPAY_API_KEY>")
# Cấu hình chuỗi ngẫu nhiên bí mật tại cấu hình Webhook trên trang quản trị SePay
SEPAY_API_KEY=

# Thời gian hết hạn của đơn hàng (phút, mặc định 30)
ORDER_TTL_MINUTES=30

# ==============================================================================
# SMTP CẤU HÌNH GỬI EMAIL (NODEMAILER)
# Khi để trống, chế độ dev sẽ in link xác nhận/reset mật khẩu trực tiếp ra console
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CyberKnight Shield" <no-reply@sigmabloom.vn>

# Địa chỉ email nhận góp ý/phản hồi (Feedback) từ người dùng
FEEDBACK_TO=

# Thời hạn hiệu lực của mã đặt lại mật khẩu (phút)
RESET_TOKEN_TTL_MINUTES=15
